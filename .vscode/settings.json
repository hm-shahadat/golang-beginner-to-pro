{
    // This is for customised you VS front size, colour, style and other settings. You can change the font size, line height, letter spacing, font weight, and font family to your preference. Additionally, you can customize the token colors for different scopes in your code.
"editor.fontSize": 20,
"editor.lineHeight": 32,
"editor.letterSpacing": 0.8,
"editor.fontWeight": "normal",
"editor.fontFamily": "'Times New Roman', serif",
"editor.tokenColorCustomizations": {
    "textMateRules": [
        {
            "name": "Eye-friendly soft green for plain text and variables",
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "source.go"
            ],
            "settings": {
                "foreground": "#93C47D"
            }
        },
        {
            "name": "Eye-friendly muted slate blue for packages and libraries",
            "scope": [
                "entity.name.import",
                "storage.modifier.package",
                "support.function",
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#8EBAE5"
            }
        }
    ]
},
"sqltools.connections": [
    {
        "ssh": "Disabled",
        "previewLimit": 50,
        "server": "localhost",
        "port": 5432,
        "driver": "PostgreSQL",
        "name": "bms",
        "database": "bms_dev",
        "username": "postgres",
        "password": "123456"
    }
]


}